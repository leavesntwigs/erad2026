g.Pool(\n        procs\n    )  # Pool of processors. Defaults to all available logical cores\n\n    results = []\n    # chunksize=1 means feed a process a new job as soon as the process is idle.\n    # In our case, this restricts the queue to one \"dispatcher\" which is faster.\n    r = pool.map_async(generate, fstrs, chunksize=1, callback=results.append)\n    r.wait()\n\n    return results[0]","key":"pPls5EiIIN"},{"type":"outputs","id":"ZkhXgu2UHj-0yV2UfNbPG","children":[],"key":"oCSDGbDyBW"}],"key":"CFzw1Gpmde"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"children":[{"type":"text","value":"Feed the monster, asynchronously!","position":{"start":{"line":153,"column":1},"end":{"line":153,"column":1}},"key":"hC9FUVObaY"}],"identifier":"feed-the-monster-asynchronously","label":"Feed the monster, asynchronously!","html_id":"feed-the-monster-asynchronously","implicit":true,"key":"PKEMQ67Okg"}],"key":"hIBDTDayqY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"before = time.time()\nofstrs = multi_generate(ifstrs)\nafter = time.time()\n\nprint(\"Processing time: %3.2f seconds\" % (after - before))","key":"Fp0tfE1LC9"},{"type":"outputs","id":"YJkJ61_uAkTrVrITBoG9m","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Processing time: 2.45 seconds\n"},"key":"M8qCbEOof6"}],"key":"WluXeruGu2"}],"key":"TtEWuxBsDV"},{"type":"block","children":[],"key":"j2aM5bcmrx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"LOnpAHGbTh"},{"type":"outputs","id":"QC-w0UQIeZdfIXfruEBXe","children":[],"key":"vCTwQOcg0a"}],"key":"TLYBgeFdZB"}],"key":"T9p6KepjBv"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Quality Control using DR","url":"/notebooks/baltrad/baltrad-short-course/baltrad-d